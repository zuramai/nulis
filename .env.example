# MongoDB connection string
NUXT_MONGODB_URI=mongodb://127.0.0.1:27017/nulis

# Secret used to seal session cookies (min. 32 characters)
NUXT_SESSION_PASSWORD=change-me-to-a-random-string-of-32-chars-or-more

# Secret used to encrypt GitHub tokens in the database (min. 32 characters)
NUXT_ENCRYPTION_KEY=change-me-to-another-random-string-of-32-chars

# GitHub OAuth App (https://github.com/settings/developers)
# Authorization callback URL: <your site>/auth/github
NUXT_OAUTH_GITHUB_CLIENT_ID=
NUXT_OAUTH_GITHUB_CLIENT_SECRET=

# Optional: use an in-memory fake GitHub seeded with sample repos (demo / tests)
# NUXT_FAKE_GIT=true
